{
  "manifest_version": 3,
  "name": "Nerimity – Copy Role Permissions",
  "version": "1.0.0",
  "description": "Guided assistant that copies role permissions from one channel to other channels in Nerimity.",
  "permissions": ["storage", "webRequest", "tabs", "activeTab"],
  "host_permissions": ["https://nerimity.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://nerimity.com/app/servers/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copy role permissions – Nerimity"
  }
}
